PORT=3000
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=12h
FUSION_BOOTSTRAP_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000
FUSION_JSON_BODY_LIMIT=10mb
FUSION_FORM_BODY_LIMIT=2mb

# Banco local para homologação. Não envia dados ao Supabase.
FUSION_DATABASE_PROVIDER=json
FUSION_JSON_FALLBACK=true
FUSION_MIGRATE_JSON_ON_START=false
FUSION_SYNC_DATA_ON_LOCAL=false
FUSION_REQUIRE_SUPABASE_DATA=false

# Preencha somente na implantação, nunca envie chaves reais ao Git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATA_BUCKET=fusion-data
SUPABASE_BACKUP_BUCKET=fusion-backups
FUSION_TENANT_ID=academia-piloto
FUSION_DATA_SYNC_MS=5000
FUSION_BACKUP_AUTO=false
FUSION_BACKUP_AUTO_ON_LOCAL=false
FUSION_BACKUP_AUTO_MS=21600000

# Fusion Access Agent (opcional no localhost)
ACCESS_AGENT_ID=academia-piloto-agent-01
ACCESS_AGENT_TENANT_ID=academia-piloto
ACCESS_AGENT_TOKEN=
# Use ACCESS_AGENT_TOKEN_SHA256 em producao quando o token claro nao precisar ser entregue pelo onboarding.
ACCESS_AGENT_TOKEN_SHA256=
ACCESS_AGENT_TOKEN_EXPIRES_AT=
ACCESS_AGENT_TOKEN_NEXT=
ACCESS_AGENT_TOKEN_SHA256_NEXT=
ACCESS_AGENT_TOKEN_NEXT_NOT_BEFORE=
ACCESS_AGENT_TOKEN_NEXT_EXPIRES_AT=
# JSON opcional para varios agentes: {"academia-piloto-agent-01":{"tenantId":"academia-piloto","tokenHash":"sha256...","equipmentIds":["catraca-piloto-01"]}}
ACCESS_AGENT_CREDENTIALS=
ACCESS_AGENT_MAX_CLOCK_SKEW_MS=300000
ACCESS_AGENT_REQUIRE_EQUIPMENT_HEADER=false
ACCESS_SERVER_URL=http://localhost:3000
ACCESS_AGENT_POLL_MS=1500
ACCESS_EQUIPMENT_ID=catraca-piloto-01
ACCESS_EQUIPMENT_IDS=catraca-piloto-01
HENRY_HOST=
HENRY_PORT=3000
