{
  "name": "fusion-erp",
  "version": "2.8.1-piloto",
  "description": "Fusion ERP 2.8.1 - Financeiro e cobrança automática",
  "private": true,
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "check": "node scripts/verificar-projeto.mjs",
    "reset:virgem": "node scripts/resetar-sistema-virgem.mjs",
    "reset:simular": "node scripts/resetar-sistema-virgem.mjs --dry-run",
    "reset:admin": "node scripts/reset-admin-password.mjs",
    "render:check": "node scripts/render-smoke-test.mjs",
    "render:start": "NODE_ENV=production node server.mjs",
    "backup:supabase": "node scripts/backup-supabase.mjs",
    "backup:local": "node scripts/backup-local.mjs",
    "backup:data": "node scripts/backup-data.mjs",
    "package:seguro": "node scripts/empacotar-v3.mjs",
    "migrate:supabase": "node scripts/migrar-json-supabase-v3.mjs",
    "migrate:financeiro:simular": "node scripts/migrar-financeiro-ledger-v1.mjs",
    "migrate:financeiro": "node scripts/migrar-financeiro-ledger-v1.mjs --apply",
    "test:financeiro": "node scripts/test-financeiro-ledger.mjs",
    "test:localhost": "node scripts/test-localhost-financeiro.mjs",
    "test:cobranca-automatica": "node scripts/test-cobranca-automatica-http.mjs",
    "reconciliar:financeiro:simular": "node scripts/reconciliar-financeiro-caixa.mjs --supabase",
    "reconciliar:financeiro": "node scripts/reconciliar-financeiro-caixa.mjs --supabase --apply",
    "piloto:280": "npm run check && npm run backup:data",
    "access:agent": "node scripts/fusion-access-agent.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.53.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.0.5"
  }
}
