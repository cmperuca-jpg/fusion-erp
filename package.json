{
  "name": "fusion-erp",
  "version": "2.8.1-piloto",
  "description": "Fusion ERP 2.8.1 - Financeiro e cobrança automática",
  "private": true,
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "check": "node scripts/verificar-projeto.mjs",
    "reset:virgem": "node scripts/resetar-sistema-virgem.mjs",
    "reset:simular": "node scripts/resetar-sistema-virgem.mjs --dry-run",
    "reset:admin": "node scripts/reset-admin-password.mjs",
    "render:check": "node scripts/render-smoke-test.mjs",
    "render:start": "NODE_ENV=production node server.mjs",
    "backup:supabase": "node scripts/backup-supabase.mjs",
    "backup:local": "node scripts/backup-local.mjs",
    "backup:data": "node scripts/backup-data.mjs",
    "package:seguro": "node scripts/empacotar-v3.mjs",
    "migrate:supabase": "node scripts/migrar-json-supabase-v3.mjs",
    "migrate:financeiro:simular": "node scripts/migrar-financeiro-ledger-v1.mjs",
    "migrate:financeiro": "node scripts/migrar-financeiro-ledger-v1.mjs --apply",
    "test:financeiro": "node scripts/test-financeiro-ledger.mjs",
    "test:mensalidades-em-aberto": "node scripts/test-mensalidades-em-aberto.mjs",
    "test:localhost": "node scripts/test-localhost-financeiro.mjs",
    "test:cobranca-automatica": "node scripts/test-cobranca-automatica-http.mjs",
    "test:access-agent-auth": "node scripts/test-access-bridge-agent-auth.mjs",
    "test:access-liberacao-integrada": "node scripts/test-access-liberacao-integrada.mjs",
    "test:multiempresa-isolamento": "node scripts/test-multiempresa-isolamento.mjs",
    "test:p0-http-multiempresa": "node scripts/test-p0-http-multiempresa-smoke.mjs",
    "test:regressoes-p0": "node scripts/test-regressoes-p0-fusion.mjs",
    "test:p0-auditoria": "npm run test:access-agent-auth && npm run test:access-liberacao-integrada && npm run test:multiempresa-isolamento && npm run test:p0-http-multiempresa && npm run test:financeiro && npm run test:financeiro:persistencia && npm run test:mensalidades-em-aberto && npm run test:cobranca-automatica && npm run test:regressoes-p0 && npm run test:p0-jornada-financeiro-acesso && npm run test:aluno-app-acoes && npm run test:aluno-app-frequencia && npm run test:access-frequencia-sync && npm run test:pagamentos-online && npm run test:aluno-app-entrada-saida",
    "test:observabilidade-webhook": "node scripts/test-observabilidade-webhook.mjs",
    "test:observabilidade": "node scripts/test-observabilidade-http.mjs && node scripts/test-observabilidade-agendador.mjs && node scripts/test-observabilidade-webhook.mjs",
    "test:saas-billing-manual": "node scripts/test-saas-billing-manual.mjs",
    "test:saas-billing-policy": "node scripts/test-saas-billing-policy.mjs",
    "test:saas-billing-automatico": "node scripts/test-saas-billing-automatico.mjs",
    "test:saas-billing": "npm run test:saas-billing-manual && npm run test:saas-billing-policy && npm run test:saas-billing-automatico && npm run test:saas-billing-enforcement",
    "test:implantacao-repetivel": "node scripts/test-implantacao-repetivel.mjs",
    "provisionar:fusion-aluno": "node scripts/provisionar-academia-fusion-aluno.mjs",
    "test:provisionamento-fusion-aluno": "node scripts/test-provisionamento-academia-fusion-aluno.mjs",
    "test:p1-implantacao": "npm run test:implantacao-repetivel && npm run test:provisionamento-fusion-aluno",
    "reconciliar:financeiro:simular": "node scripts/reconciliar-financeiro-caixa.mjs",
    "reconciliar:financeiro": "node scripts/reconciliar-financeiro-caixa.mjs --apply",
    "piloto:280": "npm run check && npm run backup:data",
    "access:agent": "node scripts/fusion-access-agent.mjs",
    "test:p0-jornada-financeiro-acesso": "node scripts/test-p0-jornada-financeiro-acesso-http.mjs",
    "test:saas-billing-enforcement": "node scripts/test-saas-billing-enforcement.mjs",
    "test:aluno-app-acoes": "node scripts/test-aluno-app-acoes.mjs",
    "test:aluno-app-frequencia": "node scripts/test-aluno-app-frequencia.mjs",
    "test:access-frequencia-sync": "node scripts/test-access-frequencia-sync.mjs",
    "test:pagamentos-online": "node scripts/test-pagamentos-online.mjs",
    "test:aluno-app-entrada-saida": "node scripts/test-aluno-app-entrada-saida.mjs",
    "test:financeiro:persistencia": "node scripts/test-financeiro-persistencia-segura.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.53.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "zod": "^4.0.5"
  }
}
